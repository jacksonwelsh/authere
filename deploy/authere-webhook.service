[Unit]
Description=Authere GitHub webhook receiver
After=network.target

[Service]
Type=simple
User=authere
Group=authere
ExecStart=/usr/bin/python3 /opt/authere/webhook.py
Restart=on-failure
RestartSec=5

EnvironmentFile=/opt/authere/webhook.env

# NoNewPrivileges is intentionally NOT set: deploy.sh must invoke
# `sudo systemctl restart authere`, and sudo is setuid-root so it cannot
# escalate while NoNewPrivileges is in effect. Privilege is already tightly
# scoped via /etc/sudoers.d/authere (only three systemctl commands).
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/authere
PrivateTmp=true

[Install]
WantedBy=multi-user.target
